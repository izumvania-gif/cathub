# Local development. On Amvera these are set in the project's "Переменные" tab.

# Superuser for PocketBase; the entrypoint upserts it on start and the bot logs in with it.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-please

# PocketBase URL for the bot (same container on Amvera).
PB_URL=http://127.0.0.1:8090

# Telegram bot token from @BotFather. Without it the bot only writes PocketBase heartbeats.
BOT_TOKEN=

# Optional: bot username without @ for the "Подключить Telegram" link. If empty, the username
# the bot reports in its heartbeat (from getMe) is used.
TELEGRAM_BOT_USERNAME=

# Public app URL, used in bot messages (e.g. https://cathub-user.amvera.io).
APP_URL=

# Optional custom Bot API root for a fallback relay (no trailing slash). Empty = api.telegram.org.
TELEGRAM_API_ROOT=

# Optional: quiet hours for the household group chat, HH:MM-HH:MM (default 23:00-08:00).
GROUP_QUIET_HOURS=

# Automatic backups (see docs/DEPLOY_AMVERA.md §6). Cron is UTC; "off" disables.
BACKUP_CRON=
BACKUP_MAX_KEEP=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET=
